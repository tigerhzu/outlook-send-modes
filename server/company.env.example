# Copy outside the public dist directory. Never commit populated credentials.
PUBLIC_ORIGIN=https://templates.example.com
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# SPA client app used by Office dialog MSAL
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# API app ID; configure requestedAccessTokenVersion=2
ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
HOST=127.0.0.1
PORT=8080
CATALOG_PROVIDER=file
CATALOG_FILE=.runtime/company/catalog-state.json
DIST_DIR=dist
# Optional service-only SharePoint document backend
# CATALOG_PROVIDER=sharepoint
# SHAREPOINT_SITE_URL=https://tenant.sharepoint.com/sites/Templates
# SHAREPOINT_FILE_PATH=/sites/Templates/ServiceOnly/catalog-state.json
# SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_CERT_PATH=/run/secrets/sharepoint.pem
# SHAREPOINT_CERT_PASSWORD=
