# 寄信模式 1.7 公司設定（範本庫放 SharePoint）
# 複製到部署根目錄並改名為 .env，把「待填」換成實際值：
#   前 4 行來自 setup-entra.ps1 產生的 entra-result.txt
#   SHAREPOINT_* 來自 setup-sharepoint.ps1 產生的 sharepoint-result.txt
# 這裡只有公開識別碼和檔案路徑，沒有密碼或私鑰；仍請勿放進 dist/ 或公開網站。

PUBLIC_ORIGIN=待填_正式HTTPS網址_例如_https://templates.company.example
ENTRA_TENANT_ID=待填_租戶GUID
ENTRA_CLIENT_ID=待填_登入SPA的Client_ID
ENTRA_API_AUDIENCE=待填_範本API的Client_ID_只填GUID

# 反向代理（IIS／nginx 等）轉送到這裡；容器或 Azure App Service 改 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8080
DIST_DIR=dist

CATALOG_PROVIDER=sharepoint
SHAREPOINT_SITE_URL=待填_例如_https://contoso.sharepoint.com/sites/SendModes
SHAREPOINT_FILE_PATH=待填_例如_/sites/SendModes/Shared Documents/catalog-state.json
SHAREPOINT_CLIENT_ID=待填_SharePoint後端App的Client_ID
# 主機上「私鑰＋憑證」合併的 PEM，放在部署目錄以外，只讓服務帳號可讀
SHAREPOINT_CERT_PATH=待填_例如_/etc/sendmodes/sharepoint.pem_或_D:/SendModesSecrets/sharepoint.pem

# 若 SharePoint 授權還沒好、要先用主機檔案試行：把上面 5 行 SHAREPOINT／CATALOG_PROVIDER 註解掉，改用下面兩行
# CATALOG_PROVIDER=file
# CATALOG_FILE=D:/SendModesData/catalog-state.json
